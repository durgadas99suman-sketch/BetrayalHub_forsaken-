    -- Audio block attempt
    local function attemptSoundBlock(sound, mode)
        if not autoBlockAudioOn then return end
        if not sound or not sound:IsA("Sound") or not sound.IsPlaying then return end
        local id = extractSoundId(sound)
        if not id or not autoBlockTriggerSounds[id] then return end
        local now = tick()
        if soundBlockedUntil[sound] and now < soundBlockedUntil[sound] then return end
        if now - lastLocalBlockTime < AUDIO_LOCAL_COOLDOWN then return end
        local myChar = lp.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local _, soundPart = getSoundPos(sound)
        if not soundPart then return end
        local char = getCharFromDesc(soundPart)
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if not hasLOS(hrp) then return end
        local dx = hrp.Position.X-myRoot.Position.X
        local dy = hrp.Position.Y-myRoot.Position.Y
        local dz = hrp.Position.Z-myRoot.Position.Z
        if dx*dx+dy*dy+dz*dz > detectionRangeSq*1.3 then return end
        local plr = svc.Players:GetPlayerFromCharacter(char)
        if not plr or plr == lp then return end
        if facingCheckEnabled and not isFacingAB(myRoot, hrp) then return end
        task.wait(blockdelay)
        if mode=="Block" and autoblockToggles["Block"] then
            if cachedCooldown and cachedCooldown.Text ~= "" then return end
            fireRemoteBlock()
        elseif mode=="Charge" and autoblockToggles["Charge"] then
            if cachedChargeBtn and cachedChargeBtn:FindFirstChild("CooldownTime") and cachedChargeBtn.CooldownTime.Text ~= "" then return end
            fireRemoteCharge(); startChargeAim(0.4)
        elseif mode=="Clone" and autoblockToggles["Clone"] then
            if cachedCloneBtn and cachedCloneBtn:FindFirstChild("CooldownTime") and cachedCloneBtn.CooldownTime.Text ~= "" then return end
            fireRemoteClone(); startChargeAim(0.4)
        end
        lastLocalBlockTime = now
        soundBlockedUntil[sound] = now + AUDIO_SOUND_THROTTLE
    end

    -- Anti-flick parts
    local function attemptBDParts(sound)
        if not autoBlockAudioOn or not antiFlickOn then return end
        if not sound or not sound:IsA("Sound") or not sound.IsPlaying then return end
        local id = extractSoundId(sound)
        if not id or not autoBlockTriggerSounds[id] then return end
        local t = tick()
        if soundBlockedUntil[sound] and t < soundBlockedUntil[sound] then return end
        local myChar = lp.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local _, soundPart = getSoundPos(sound)
        if not soundPart then return end
        local char = getCharFromDesc(soundPart)
        local plr = char and svc.Players:GetPlayerFromCharacter(char)
        if not plr or plr == lp then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not hasLOS(hrp) then return end
        local baseSize = Vector3.new(5.5,7.5,8.5) * (blockPartsSizeMultiplier or 1)
        local count = math.max(1, antiFlickParts or 4)
        local base = antiFlickBaseOffset or 2.5
        task.spawn(function()
            local blocked = false
            task.wait(antiFlickDelay or 0)
            for i=1,count do
                if not hrp or not myRoot then break end
                local st = killerState[char] or {vel=hrp.Velocity or Vector3.new(), angVel=0}
                local vel = st.vel or hrp.Velocity or Vector3.new()
                local pS = predictionStrength or 1; local pT = predictionTurnStrength or 1
                local fwdP = math.clamp(vel:Dot(hrp.CFrame.LookVector)*PRED_SECONDS_FWD*pS, -PRED_MAX_FWD*pS, PRED_MAX_FWD*pS)
                local latP = math.clamp(vel:Dot(hrp.CFrame.RightVector)*PRED_SECONDS_LAT*pS, -PRED_MAX_LAT*pS, PRED_MAX_LAT*pS)
                local turnL= math.clamp(st.angVel*ANG_TURN_MULT*pT, -PRED_MAX_LAT*pT, PRED_MAX_LAT*pT)
                local spawnPos = hrp.Position + hrp.CFrame.LookVector*(base+(i-1)*(antiFlickOffsetStep or 0)+fwdP) + hrp.CFrame.RightVector*(latP+turnL)
                local part = Instance.new("Part")
                part.Name="AntiFlickZone"; part.Size=baseSize; part.Material=Enum.Material.ForceField
                part.Transparency=0.45; part.Anchored=true; part.CanCollide=false
                part.CFrame=CFrame.new(spawnPos, hrp.Position); part.BrickColor=BrickColor.new("Bright blue")
                part.Parent=svc.WS; svc.Debris:AddItem(part, 0.2)
                if isPointInsidePart(part, myRoot.Position) then blocked = true end
                if blocked then
                    if not (facingCheckEnabled and not isFacingAB(myRoot, hrp)) then
                        doFire(); soundBlockedUntil[sound] = t + 1.2
                    end
                    break
                end
                if stagger and stagger > 0 then task.wait(stagger) else task.wait(0) end
            end
        end)
    end

    -- Sound hook
    local function hookSound(sound)
        if not sound or not sound:IsA("Sound") or soundHooks[sound] then return end
        local preId = extractSoundId(sound)
        soundHooks[sound] = {id=preId}
        local function handle(snd)
            if not autoBlockAudioOn then return end
            if not antiFlickOn then
                if autoblockToggles["Block"]  then attemptSoundBlock(snd, "Block")  end
                if autoblockToggles["Charge"] then attemptSoundBlock(snd, "Charge") end
                if autoblockToggles["Clone"]  then attemptSoundBlock(snd, "Clone")  end
            else
                attemptBDParts(snd)
            end
        end
        local pc = sound.Played:Connect(function() handle(sound) end)
        local ic = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function() if sound.IsPlaying then handle(sound) end end)
        local dc; dc = sound.Destroying:Connect(function()
            if pc and pc.Connected then pc:Disconnect() end
            if ic and ic.Connected then ic:Disconnect() end
            if dc and dc.Connected then dc:Disconnect() end
            soundHooks[sound] = nil; soundBlockedUntil[sound] = nil
        end)
        soundHooks[sound] = {id=preId, pc=pc, ic=ic, dc=dc}
        if sound.IsPlaying then handle(sound) end
    end

