            local cam=svc.WS.CurrentCamera
            if tt.lockMode=="Cam + Humanoid" or tt.lockMode=="Cam Only" then
                if cam then cam.CFrame=CFrame.new(cam.CFrame.Position,kHRP.Position+Vector3.new(0,1.5,0)) end
            end
            if tt.lockMode=="Cam + Humanoid" or tt.lockMode=="Humanoid Only" then
                myHRP.CFrame=CFrame.new(myHRP.Position,Vector3.new(kHRP.Position.X,myHRP.Position.Y,kHRP.Position.Z))
            end
        end)
    end
    local function checkBackstabCondition()
        if not tt.enabled or tt.activeBackstabConn or (os.clock()-tt.lastStab)<tt.cooldown then return end
        if isDaggerOnCooldown() then return end
        local char=lp.Character;local myHRP=char and char:FindFirstChild("HumanoidRootPart")
        if not char or not myHRP then return end
        local kf=getTeamFolder("Killers");if not kf then return end
        for _,killer in ipairs(kf:GetChildren()) do
            if killer:IsA("Model") and killer~=char then
                local kHRP=killer:FindFirstChild("HumanoidRootPart");local kHum=killer:FindFirstChildOfClass("Humanoid")
                if kHRP and kHum and kHum.Health>0 then
                    local dist=(kHRP.Position-myHRP.Position).Magnitude
                    if dist<=tt.range then
                        local dot=(myHRP.Position-kHRP.Position).Unit:Dot(-kHRP.CFrame.LookVector)
                        if dot>=math.cos(math.rad(tt.coneAngle/2)) then
                            if tt.checkObstacles then
                                local rp=RaycastParams.new();rp.FilterType=Enum.RaycastFilterType.Exclude;rp.FilterDescendantsInstances={char,killer}
                                if svc.WS:Raycast(myHRP.Position,kHRP.Position-myHRP.Position,rp) then continue end
                            end
                            executeBackstab(killer);break
                        end
                    end
                end
            end
        end
    end
