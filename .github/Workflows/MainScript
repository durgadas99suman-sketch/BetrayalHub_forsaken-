local requestFunc = request or http_request or (syn and syn.request) or (http and http.request)

local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        return true
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
        return true
    end
    return false
end

-- Save key locally to file
local function saveSavedKey(key)
    if writefile then
        pcall(writefile, KEY_FILE, key)
    end
end

-- Load locally saved key
local function getSavedKey()
    if isfile and readfile and isfile(KEY_FILE) then
        local ok, data = pcall(readfile, KEY_FILE)
        if ok and data then
            return string.gsub(data, "^%s*(.-)%s*$", "%1")
        end
    end
    return nil
end

-- Delete invalid or expired local key
local function removeSavedKey()
    if isfile and delfile and isfile(KEY_FILE) then
        pcall(delfile, KEY_FILE)
    end
end

