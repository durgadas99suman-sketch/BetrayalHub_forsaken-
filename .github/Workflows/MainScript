local function addMobileMenuButton()
    pcall(function()
        local pg = lp:FindFirstChildOfClass("PlayerGui") or lp:WaitForChild("PlayerGui", 5)
        if not pg then return end
        local old = pg:FindFirstChild("BetrayalHub_MobileMenu")
        if old then old:Destroy() end

        local gui = Instance.new("ScreenGui")
        gui.Name = "BetrayalHub_MobileMenu"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.DisplayOrder = 999999
        gui.Parent = pg

        local btn = Instance.new("TextButton")
        btn.Name = "OpenMenu"
        btn.Size = UDim2.new(0, 55, 0, 55)
        btn.Position = UDim2.new(0, 20, 0.5, 0)
        btn.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
        btn.BackgroundTransparency = 0.15
        btn.Text = "✦"
        btn.TextSize = 28
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBlack
        btn.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0) -- Circle
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2
        stroke.Color = Color3.fromRGB(0, 195, 255)
        stroke.Parent = btn

        local grad = Instance.new("UIGradient")
        grad.Rotation = 45
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 195, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(168, 85, 255))
        })
        grad.Parent = stroke

        -- Glow Effect
        local glow = Instance.new("UIStroke")
        glow.Thickness = 4
        glow.Color = Color3.fromRGB(0, 195, 255)
        glow.Transparency = 0.8
        glow.Parent = btn

        -- Animation Loop (Spinning back and forth + Pulsing Glow)
        task.spawn(function()
            local ts = game:GetService("TweenService")
            while btn and btn.Parent do
                ts:Create(btn, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Rotation = 25}):Play()
                ts:Create(glow, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.4}):Play()
                task.wait(1.5)
                ts:Create(btn, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Rotation = -25}):Play()
                ts:Create(glow, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.8}):Play()
                task.wait(1.5)
            end
        end)

        -- Robust Menu Toggle Logic
        local function toggleMenu()
            pcall(function()
                -- Try to find the GUI element associated with the Panel
                local uiGui = Panel.Gui or Panel.ScreenGui or Panel.MainGui
                if not uiGui and type(Panel.GetGui) == "function" then
                    uiGui = Panel:GetGui()
                end
                
                -- Fallback: search CoreGui and PlayerGui for RBUI ScreenGui
                if not uiGui then
                    for _, v in pairs(game:GetService("CoreGui"):GetChildren()) do
                        if v:IsA("ScreenGui") and (v.Name:match("RBUI") or v.Name:match("UIFramework")) then
                            uiGui = v; break
                        end
                    end
                end
                if not uiGui then
                    local pg = lp:FindFirstChildOfClass("PlayerGui")
                    if pg then
                        for _, v in pairs(pg:GetChildren()) do
                            if v:IsA("ScreenGui") and (v.Name:match("RBUI") or v.Name:match("UIFramework")) then
                                uiGui = v; break
                            end
                        end
                    end
                end
                
                -- Toggle visibility
                if uiGui then
                    uiGui.Enabled = not uiGui.Enabled
                else
                    -- Last resort: try calling common toggle/minimize methods
                    if type(Panel.SetVisible) == "function" then
                        Panel:SetVisible(not Panel.IsVisible)
                    elseif type(Panel.Toggle) == "function" then
                        Panel:Toggle()
                    elseif type(Panel.Minimize) == "function" then
                        Panel:Minimize()
                    end
                end
            end)
        end

        -- Draggable Logic (Touch & Mouse)
        local dragging, dragInput, dragStart, startPos
        local dragOffset = Vector2.zero

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = btn.Position
                dragOffset = Vector2.zero
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        -- If it was a small movement, treat as click
                        if dragOffset.Magnitude < 10 then
                            toggleMenu()
                        end
                    end
                end)
            end
        end)
        btn.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        svc.Input.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                dragOffset = delta
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end)
end
