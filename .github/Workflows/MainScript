                    if dist <= tt.range then
                        local dirToPlayer = (myHRP.Position - kHRP.Position).Unit
                        local killerBack = -kHRP.CFrame.LookVector
                        local dot = dirToPlayer:Dot(killerBack)
                        local threshold = math.cos(math.rad(tt.coneAngle / 2))
                        if dot >= threshold then
                            if tt.checkObstacles then
                                local params = RaycastParams.new()
                                params.FilterType = Enum.RaycastFilterType.Exclude
