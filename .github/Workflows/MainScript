        local ping = 0.05
        pcall(function()
            local stat = svc.Stats:FindFirstChild("PerformanceStats")
            local pingStat = stat and stat:FindFirstChild("Ping")
            if pingStat then ping = (pingStat:GetValue() or 50) / 1000 end
        end)
        local tLead = math.clamp(ping + 0.04, 0.04, 0.2)
        local kVel = kHRP.AssemblyLinearVelocity
        if not kVel or kVel.Magnitude < 0.1 then kVel = kHRP.Velocity end
        local predPos = kHRP.Position + (Vector3.new(kVel.X, 0, kVel.Z) * tLead)
        local lookDir = kHRP.CFrame.LookVector
        local behindPos = predPos - (lookDir * tt.behindDist)
        behindPos = Vector3.new(behindPos.X, myHRP.Position.Y, behindPos.Z)
        if tt.lockMode ~= "Humanoid Only" and tt.lockMode ~= "Cam Only" then
            myHRP.CFrame = CFrame.new(behindPos, Vector3.new(kHRP.Position.X, myHRP.Position.Y, kHRP.Position.Z))
