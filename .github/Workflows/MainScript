    end
    local function mergeKnown(dst, src)
        if type(dst) ~= "table" or type(src) ~= "table" then return dst end
        for k, defaultValue in pairs(dst) do
            local incoming = src[k]
            if incoming ~= nil then
                if type(defaultValue) == "table" then
                    if type(incoming) == "table" then mergeKnown(defaultValue, incoming) end
                elseif type(incoming) == type(defaultValue) then
                    dst[k] = incoming
                end
            end
        end
        return dst
    end
