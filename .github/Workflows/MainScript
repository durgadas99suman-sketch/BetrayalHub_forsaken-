-- Verification Request Executor
local function verifyKeyProcess(isAutoCheck)
    -- Multiple Request Lock
    if isRequesting then
        return
    end

    local rawText = keyTextBox.Text
    local trimmedKey = string.gsub(rawText, "^%s*(.-)%s*$", "%1")

    -- Format Validation
    if trimmedKey == "" then
        setState(State.ERROR, "⚠️ Please enter a verification key.")
        return
    end

    if not string.find(trimmedKey, "^BV%-") then
        removeSavedKey()
        setState(State.ERROR, "❌ Invalid format. Key must start with 'BV-'.")
        return
    end

    -- Status message configuration
    local checkingMsg = isAutoCheck 
        and "📡 Connecting, please wait...\nAuto-checking saved key..." 
        or "📡 Connecting, please wait...\nValidating key with backend..."

    setState(State.CHECKING, checkingMsg)

    -- Asynchronous Network Request
    task.spawn(function()
        if not requestFunc then
            setState(State.ERROR, "📡 Executor does not support HTTP requests.")
            return
        end

        -- Construct JSON payload with key AND roblox_user_id
        local payload = HttpService:JSONEncode({
            key = trimmedKey,
            roblox_user_id = tostring(LocalPlayer.UserId)
        })

        local success, response = pcall(function()
            return requestFunc({
                Url = VERIFY_ENDPOINT,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = payload
            })
        end)

        -- Network failure handling
        if not success or not response then
            setState(State.ERROR, "📡 Unable to contact the verification server.")
            return
        end

        local statusCode = response.StatusCode or response.Status
        local responseBody = response.Body

        if not responseBody or responseBody == "" then
            setState(State.ERROR, "⚠️ Invalid response from verification server.")
            return
        end

        -- Safe JSON parsing
        local parseSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(responseBody)
        end)

        if not parseSuccess or type(decoded) ~= "table" then
            setState(State.ERROR, "⚠️ Invalid response from verification server.")
            return
        end

        ------------------------------------------------------------------------
        -- RESPONSE DISPATCHING & SCRIPT LOADER
        ------------------------------------------------------------------------
        if decoded.ok == true and decoded.verified == true then
            saveSavedKey(trimmedKey)

            local verifiedUser = decoded.roblox_username or LocalPlayer.Name
            local msg = "✅ Verification Successful\nAccount: " .. tostring(verifiedUser) .. "\nYou are verified."
            setState(State.SUCCESS, msg)

            task.wait(1.5)

            local fade = tweenObject(mainFrame, {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

            fade.Completed:Wait()
            screenGui:Destroy()

            task.spawn(function()
                local execSuccess, execErr = pcall(function()
                    loadstring(game:HttpGet(SCRIPT_URL))()
                end)

                if not execSuccess then
                    warn("[Verification System] Error loading main script: " .. tostring(execErr))
                end
            end)

        else
            local errCode = tostring(decoded.error or "")
            local errMsg = tostring(decoded.message or "")
            local combined = string.lower(errCode .. " " .. errMsg)

            -- ALREADY VERIFIED = ALLOW ACCESS
            if string.find(combined, "already_verified")
                or string.find(combined, "already verified") then

                saveSavedKey(trimmedKey)

                setState(
                    State.SUCCESS,
                    "✅ Account already verified\nAccount: " .. LocalPlayer.Name .. "\nLoading script..."
                )

                task.wait(1.5)

                local fade = tweenObject(mainFrame, {
                    Size = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1
                }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

                fade.Completed:Wait()
                screenGui:Destroy()

                task.spawn(function()
                    local execSuccess, execErr = pcall(function()
                        loadstring(game:HttpGet(SCRIPT_URL))()
                    end)

                    if not execSuccess then
                        warn("[Verification System] Error loading main script: " .. tostring(execErr))
                    end
                end)

            elseif statusCode == 500 or string.find(combined, "server") then
                removeSavedKey()
                setState(State.ERROR, "⚠️ Verification server is unavailable. Please try again.")

            elseif string.find(combined, "key_owner_mismatch")
                or string.find(combined, "mismatch")
                or string.find(combined, "different roblox account") then
                removeSavedKey()
                setState(State.ERROR, "⚠️ This key belongs to a different Roblox account.")

            elseif string.find(combined, "expired") then
                removeSavedKey()
                setState(State.ERROR, "⏳ This verification key has expired.")

            elseif string.find(combined, "used") then
                removeSavedKey()
                setState(State.ERROR, "⚠️ This verification key has already been used.")

            elseif string.find(combined, "invalid_key")
                or string.find(combined, "invalid")
                or string.find(combined, "not found") then
                removeSavedKey()
                setState(State.ERROR, "❌ Invalid verification key.")

            elseif errMsg ~= "" then
                removeSavedKey()
                setState(State.ERROR, "⚠️ " .. errMsg)

            else
                removeSavedKey()
                setState(State.ERROR, "❌ Verification failed.")
            end
        end
    end)
end

