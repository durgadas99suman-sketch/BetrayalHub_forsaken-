    local function flowKey(n)
        return tostring(n.row) .. "-" .. tostring(n.col)
    end
    local function flowNeighbour(r1, c1, r2, c2)
        if r2 == r1 - 1 and c2 == c1 then return true end
        if r2 == r1 + 1 and c2 == c1 then return true end
        if r2 == r1 and c2 == c1 - 1 then return true end
        if r2 == r1 and c2 == c1 + 1 then return true end
        return false
    end
    local function flowOrder(path, endpoints)
        if type(path) ~= "table" or #path == 0 then return nil end
        local lookup = {}
        for _, node in ipairs(path) do
            if type(node) == "table" and node.row ~= nil and node.col ~= nil then
                lookup[flowKey(node)] = node
            end
        end
        local start
        for _, ep in ipairs(endpoints or {}) do
            if type(ep) == "table" and ep.row ~= nil and ep.col ~= nil and lookup[flowKey(ep)] then
                start = { row = ep.row, col = ep.col }
                break
            end
        end
        if not start then
            for _, node in ipairs(path) do
                if type(node) == "table" and node.row ~= nil and node.col ~= nil then
                    local neighbours = 0
                    for _, d in ipairs({ {-1,0}, {1,0}, {0,-1}, {0,1} }) do
                        if lookup[tostring(node.row + d[1]) .. "-" .. tostring(node.col + d[2])] then
                            neighbours = neighbours + 1
                        end
                    end
                    if neighbours == 1 then
                        start = { row = node.row, col = node.col }
                        break
                    end
                end
            end
        end
        if not start then
            local first = path[1]
            if type(first) ~= "table" or first.row == nil or first.col == nil then return nil end
            start = { row = first.row, col = first.col }
        end
        local pool, ordered = {}, {}
        for _, node in ipairs(path) do
            if type(node) == "table" and node.row ~= nil and node.col ~= nil then
                pool[flowKey(node)] = { row = node.row, col = node.col }
            end
        end
        local cur = start
        if not pool[flowKey(cur)] then return nil end
        table.insert(ordered, { row = cur.row, col = cur.col })
        pool[flowKey(cur)] = nil
        while next(pool) do
            local moved = false
            for key, node in pairs(pool) do
                if flowNeighbour(cur.row, cur.col, node.row, node.col) then
                    table.insert(ordered, { row = node.row, col = node.col })
                    pool[key] = nil
                    cur = node
                    moved = true
                    break
                end
            end
            if not moved then
                return nil
            end
        end
        return ordered
    end
    local function solveFlow(puzzle)
        if not genState.enabled or not puzzle then return false end
        local ok, result = xpcall(function()
            local solutions = puzzle.Solution or puzzle.Solutions
            local paths = puzzle.paths or puzzle.Paths
            if type(solutions) ~= "table" then
                error("FlowGame instance has no Solution table")
            end
            if type(paths) ~= "table" then
                error("FlowGame instance has no paths table")
            end
            local targetPairs = puzzle.targetPairs or puzzle.TargetPairs
            local indices = {}
            for i = 1, #solutions do indices[i] = i end
            for i = #indices, 2, -1 do
                local j = math.random(1, i)
                indices[i], indices[j] = indices[j], indices[i]
            end
            for _, ci in ipairs(indices) do
                if not genState.enabled then break end
                local solution = solutions[ci]
                if type(solution) == "table" and #solution > 0 then
                    local endpoints = targetPairs and targetPairs[ci]
                    local ordered = flowOrder(solution, endpoints)
                    if not ordered then
                        error("Could not order generator path #" .. tostring(ci))
                    end
                    paths[ci] = {}
                    for _, node in ipairs(ordered) do
                        table.insert(paths[ci], { row = node.row, col = node.col })
                        if type(puzzle.updateGui) == "function" then
                            puzzle:updateGui()
                        end
                        task.wait(math.max(0, tonumber(genState.nodeDelay) or 0.1))
                    end
                    task.wait(math.max(0, tonumber(genState.lineDelay) or 0.1))
                    if type(puzzle.checkForWin) == "function" then
                        puzzle:checkForWin()
                    else
                        error("FlowGame instance has no checkForWin method")
                    end
                end
            end
            return true
        end, debug.traceback)
        if not ok then
            genState.lastError = tostring(result)
            genNotify("Auto Generator Error", genState.lastError:match("^[^\n]+") or "Unknown error", "error")
            return false
        end
        genState.lastError = nil
        return result
    end
    local function findFlowGameModule()
        local modules = svc.RS:FindFirstChild("Modules")
        if not modules then return nil end
        local minigames = modules:FindFirstChild("Minigames")
        if minigames then
            local exactFolder = minigames:FindFirstChild("FlowGameManager")
            local exactModule = exactFolder and exactFolder:FindFirstChild("FlowGame")
            if exactModule and exactModule:IsA("ModuleScript") then
                return exactModule
            end
            for _, desc in ipairs(minigames:GetDescendants()) do
                if desc:IsA("ModuleScript") and desc.Name == "FlowGame" then
                    return desc
                end
            end
        end
        for _, desc in ipairs(modules:GetDescendants()) do
            if desc:IsA("ModuleScript") and desc.Name == "FlowGame" then
                return desc
            end
        end
        return nil
    end
    local function installGeneratorHook()
        if genState.hookInstalled then return true end
        local moduleScript = findFlowGameModule()
        if not moduleScript then return false end
        local ok, FG = pcall(require, moduleScript)
        if not ok or type(FG) ~= "table" or type(FG.new) ~= "function" then
            genState.lastError = "FlowGame module was found, but its new() constructor is unavailable."
            return false
        end
        local originalNew = FG.new
        FG.new = function(...)
            local instance = originalNew(...)
            if genState.enabled then
                task.spawn(function()
                    task.wait(0.25)
                    solveFlow(instance)
                end)
            end
            return instance
        end
        genState.hookInstalled = true
        return true
    end
