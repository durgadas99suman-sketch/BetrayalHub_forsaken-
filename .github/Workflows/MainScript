    -- Sound ID extractor
    local function extractSoundId(sound)
        if not sound then return nil end
        local sid = sound.SoundId
        if not sid then return nil end
        sid = type(sid)=="string" and sid or tostring(sid)
        return sid:match("rbxassetid://(%d+)") or sid:match("://(%d+)") or sid:match("^(%d+)$")
    end
    local function getSoundPos(sound)
        if not sound then return nil, nil end
        local p = sound.Parent
        if p then
            if p:IsA("BasePart") then return p.Position, p end
            if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent.Position, p.Parent end
        end
        return nil, nil
    end
