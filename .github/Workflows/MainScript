    -- Nearest killer
    local function getNearestKillerAB()
        local myChar = lp.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local kf = getKF(); if not kf then return nil end
        local closest, closestDist = nil, math.huge
        for _, k in ipairs(kf:GetChildren()) do
            if k and k:IsA("Model") then
                local hrp = k:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - myRoot.Position).Magnitude
                    if d < closestDist then closest, closestDist = k, d end
                end
            end
        end
        return closest
    end

    -- Killer state tracker (for prediction)
    svc.Run.RenderStepped:Connect(function(dt)
        if dt <= 0 then return end
        local kf = getKF(); if not kf then return end
        for _, killer in ipairs(kf:GetChildren()) do
            if killer and killer.Parent then
                local hrp = killer:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local st = killerState[killer] or {prevPos=hrp.Position, prevLook=hrp.CFrame.LookVector, vel=Vector3.new(), angVel=0}
                    local newVel = (hrp.Position - st.prevPos) / math.max(dt, 1e-6)
                    st.vel = st.vel:Lerp(newVel, SMOOTHING_LERP)
                    local prevLook = st.prevLook or hrp.CFrame.LookVector
                    local look = hrp.CFrame.LookVector
                    local dot = math.clamp(prevLook:Dot(look), -1, 1)
                    local crossY = prevLook:Cross(look).Y
                    local newAngVel = (math.acos(dot) / math.max(dt, 1e-6)) * ((crossY>=0) and 1 or -1)
                    st.angVel = (st.angVel * (1-SMOOTHING_LERP)) + (newAngVel * SMOOTHING_LERP)
                    st.prevPos = hrp.Position; st.prevLook = look
                    killerState[killer] = st
                end
            end
        end
    end)

