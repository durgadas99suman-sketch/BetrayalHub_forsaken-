                if tick()-t0 > fallback then break end
                task.wait()
            end
            char = lp.Character
            hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.AutoRotate = true end) end
            chargeAimActive = false
        end)
