                for _, root in ipairs(roots) do
                    local ok, found = pcall(function()
                        for _, item in ipairs(root:GetDescendants()) do
                            if item.Name == "BackgroundImage" and item:IsA("ImageLabel") then return item end
                        end
                        return nil
                    end)
                    if ok and found then background = found; break end
                end
                if background then break end
                task.wait(0.2)
            end
            if not background or not background.Parent then return end
            local old = background:FindFirstChild("BetrayalHub_Stars")
            if old then old:Destroy() end
            local folder = Instance.new("Folder"); folder.Name = "BetrayalHub_Stars"; folder.Parent = background
            background.ClipsDescendants = true
            local rng = Random.new()
            for i = 1, 24 do
                local star = Instance.new("Frame")
                star.Name = "Star_"..i; star.BorderSizePixel = 0
                star.BackgroundColor3 = (i%3==0) and Color3.fromRGB(0,229,255) or Color3.new(1,1,1)
                star.BackgroundTransparency = rng:NextNumber(0.15, 0.75)
                local px = rng:NextInteger(1, 2)
                star.Size = UDim2.fromOffset(px, px)
                star.Position = UDim2.fromScale(rng:NextNumber(0.02,0.98), rng:NextNumber(0.04,0.96))
                star.ZIndex = 1000; star.Parent = folder
                Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)
                task.spawn(function()
                    local ts = game:GetService("TweenService")
                    local base = star.BackgroundTransparency
                    while star.Parent do
                        local low = math.max(0.05, base-0.45); local high = math.min(0.92, base+0.22)
                        local a = rng:NextNumber(1.0,2.2); local b = rng:NextNumber(1.0,2.8)
                        pcall(function() ts:Create(star, TweenInfo.new(a,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut), {BackgroundTransparency=low}):Play() end)
                        task.wait(a)
                        pcall(function() ts:Create(star, TweenInfo.new(b,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut), {BackgroundTransparency=high}):Play() end)
                        task.wait(b)
                    end
                end)
            end
        end)
    end
