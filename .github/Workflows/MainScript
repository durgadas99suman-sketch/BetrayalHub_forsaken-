        math.clamp(c.R * s[1], 0, 1),
        math.clamp(c.G * s[2], 0, 1),
        math.clamp(c.B * s[3], 0, 1))
end

local function isSecondaryText(text)
    if not text then return false end
    if _brandTexts[text] then return true end
    if _sectionTitles[text] then return true end
    for _, p in ipairs(_brandPrefixes) do
        if text:sub(1, #p) == p then return true end
    end
    return false
end

-- Records an instance's original colors once, then (re)paints it with
-- the active theme. Idempotent — safe to call every sweep.
local function themeInstance(inst)
    if not inst then return end
    local rec = Theme._orig[inst]
    if rec == nil then
        rec = {}
        pcall(function()
            if inst:IsA("GuiObject") then
                rec.bg = inst.BackgroundColor3
                rec.tr = inst.BackgroundTransparency
            end
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                rec.tc = inst.TextColor3
                rec.tx = inst.Text
            end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                rec.ic = inst.ImageColor3
            end
            if inst:IsA("UIStroke") then
                rec.sc = inst.Color
            end
            if inst:IsA("UIGradient") then
                rec.gr = inst.Color
            end
            if inst:IsA("ScrollingFrame") then
                rec.sb = inst.ScrollBarImageColor3
            end
        end)
        Theme._orig[inst] = rec
    end

    pcall(function()
        -- Backgrounds (dark grays → deep space blue, accent → theme accent)
        if rec.bg then
            local cur = inst.BackgroundColor3
            if isAccentColor(cur) then
                inst.BackgroundColor3 = Theme.accent
            elseif cClose(cur, rec.bg) then
                if cSat(rec.bg) <= 0.14 and cLum(rec.bg) <= 0.40 then
                    inst.BackgroundColor3 = shiftBackground(rec.bg)
                end
            end
            if rec.tr ~= nil and rec.tr < 0.45 then
                inst.BackgroundTransparency = math.min(0.55, rec.tr + Theme.transparency)
            end
        end

        -- Text (accent → theme accent; headers/title → secondary; grays → cool shift)
        if rec.tc then
            local cur = inst.TextColor3
            if isAccentColor(cur) then
                inst.TextColor3 = Theme.accent
            elseif cClose(cur, rec.tc) then
                if isSecondaryText(rec.tx) then
                    inst.TextColor3 = Theme.secondary
                elseif cSat(rec.tc) <= 0.14 then
                    inst.TextColor3 = shiftText(rec.tc)
                end
            end
        end

        -- Images: accent replacement only (logos/art stay intact)
        if rec.ic then
            local cur = inst.ImageColor3
            if isAccentColor(cur) then
                inst.ImageColor3 = Theme.accent
            end
        end

        -- Strokes: accent or dark-gray → space-tinted border glow
        if rec.sc then
            local cur = inst.Color
            if isAccentColor(cur) then
                inst.Color = Theme.accent
            elseif cClose(cur, rec.sc) and cSat(rec.sc) <= 0.20 and cLum(rec.sc) <= 0.55 then
                inst.Color = shiftBackground(rec.sc)
            end
        end

        -- Gradients: rebuild only when an accent keypoint is present
        if rec.gr then
            local cur = inst.Color
            local hit = false
            for _, kp in ipairs(cur.Keypoints) do
                if isAccentColor(kp.Value) then hit = true; break end
            end
            if hit then
                local kps = {}
                for _, kp in ipairs(cur.Keypoints) do
                    local v = kp.Value
                    if isAccentColor(v) then v = Theme.accent end
                    kps[#kps + 1] = ColorSequenceKeypoint.new(kp.Time, v)
                end
                inst.Color = ColorSequence.new(kps)
            end
        end

        -- Scrollbars
        if rec.sb then
            local cur = inst.ScrollBarImageColor3
            if isAccentColor(cur) then
                inst.ScrollBarImageColor3 = Theme.accent
            elseif cClose(cur, rec.sb) and cSat(rec.sb) <= 0.14 then
                inst.ScrollBarImageColor3 = shiftText(rec.sb)
            end
        end
    end)

    if Theme.accent  then Theme.lastAccent  = Theme.accent  end
end

local function fullSweep()
    if not Theme.gui then return end
    pcall(function()
        for _, inst in ipairs(Theme.gui:GetDescendants()) do
            themeInstance(inst)
        end
    end)
end

-- Detects Fluent's factory accent by finding the most frequent
-- saturated color in the freshly-built UI (toggle pills, slider
-- fills, tab highlight all share it).
local function detectAccent()
    if not Theme.gui then return end
    local counts = {}
    local function bump(c)
        if not c then return end
        if cSat(c) >= 0.22 and cLum(c) >= 0.25 then
            local k = string.format("%.3f/%.3f/%.3f", c.R, c.G, c.B)
            counts[k] = (counts[k] or 0) + 1
        end
    end
    pcall(function()
        for _, inst in ipairs(Theme.gui:GetDescendants()) do
            if inst:IsA("GuiObject") then bump(inst.BackgroundColor3) end
            if inst:IsA("TextLabel") or inst:IsA("TextButton") then bump(inst.TextColor3) end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then bump(inst.ImageColor3) end
            if inst:IsA("UIStroke") then bump(inst.Color) end
            if inst:IsA("UIGradient") then
                for _, kp in ipairs(inst.Color.Keypoints) do bump(kp.Value) end
            end
        end
    end)
    local bestK, bestN = nil, 0
    for k, n in pairs(counts) do
        if n > bestN then bestN, bestK = n, k end
    end
    if bestK and bestN >= 3 then
        local r, g, b = bestK:match("^(%d+%.%d+)/(%d+%.%d+)/(%d+%.%d+)$")
        if r then Theme.origAccent = Color3.new(tonumber(r), tonumber(g), tonumber(b)) end
    end
    if not Theme.origAccent then
        Theme.origAccent = Color3.fromRGB(255, 117, 113) -- Fluent default accent (fallback)
    end
end

-- Locates Fluent's root ScreenGui by diffing GUI containers
-- before/after window creation (no dependence on internal names).
local function findFluentRootGui(preGuis, parents)
    local best, bestN = nil, -1
    pcall(function()
        for _, p in ipairs(parents) do
            for _, c in ipairs(p:GetChildren()) do
                if not preGuis[c] and c:IsA("ScreenGui") then
                    local n = #c:GetDescendants()
                    if n > bestN then bestN = n; best = c end
                end
            end
        end
    end)
    return best
end

-- ── Theme persistence (executor file APIs, fully guarded) ─────
local HttpService = game:GetService("HttpService")
local THEME_FILE  = "BetrayalHub_Theme.json"

local function saveThemeFile()
    pcall(function()
        if type(writefile) ~= "function" then return end
        local function c2t(c)
            return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
        end
        writefile(THEME_FILE, HttpService:JSONEncode({
            preset       = Theme.preset,
            accent       = c2t(Theme.accent),
            secondary    = c2t(Theme.secondary),
            transparency = Theme.transparency,
            bg           = { Theme.bgShift[1], Theme.bgShift[2], Theme.bgShift[3], Theme.bgShift[4] },
            text         = { Theme.textShift[1], Theme.textShift[2], Theme.textShift[3] },
        }))
    end)
end

local _savePending = false
local function queueSaveTheme()
    if _savePending then return end
    _savePending = true
    task.delay(1.5, function()
        _savePending = false
        saveThemeFile()
    end)
end

local function loadThemeFile()
    pcall(function()
        if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
        if not isfile(THEME_FILE) then return end
        local data = HttpService:JSONDecode(readfile(THEME_FILE))
        if type(data) ~= "table" then return end
        local custom = false
        if type(data.preset) == "string" and THEME_PRESETS[data.preset] then
            local p = THEME_PRESETS[data.preset]
            Theme.preset, Theme.bgShift, Theme.textShift = data.preset, p.bg, p.text
        end
        local function readColor(t)
            if type(t) == "table" and #t >= 3 then
                return Color3.fromRGB(
                    math.clamp(math.floor(t[1] + 0.5), 0, 255),
                    math.clamp(math.floor(t[2] + 0.5), 0, 255),
                    math.clamp(math.floor(t[3] + 0.5), 0, 255))
            end
            return nil
        end
        local a = readColor(data.accent);    if a then Theme.accent    = a; custom = true end
        local s = readColor(data.secondary); if s then Theme.secondary = s; custom = true end
        if type(data.bg) == "table" and #data.bg >= 4 then Theme.bgShift = data.bg end
        if type(data.text) == "table" and #data.text >= 3 then Theme.textShift = data.text end
        if type(data.transparency) == "number" then
            Theme.transparency = math.clamp(data.transparency, 0, 0.25)
        end
        if custom then Theme.preset = "Custom" end
    end)
end

local function applyThemePreset(name)
    local p = THEME_PRESETS[name]
    if not p then return end
    Theme.preset    = name
    Theme.accent    = p.accent
    Theme.secondary = p.secondary
    Theme.bgShift   = p.bg
    Theme.textShift = p.text
    Theme.syncing = true
    if accentPicker    then pcall(function() accentPicker:SetValue(p.accent)      end) end
    if secondaryPicker then pcall(function() secondaryPicker:SetValue(p.secondary) end) end
    if presetDropdown  then pcall(function() presetDropdown:SetValue(name)        end) end
    Theme.syncing = false
    fullSweep()
    queueSaveTheme()
end

