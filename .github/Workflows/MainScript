        if not ok then return false, tostring(encoded) end
        local saved, err = pcall(function()
            writefile(CONFIG_FILE, encoded)
        end)
        if not saved then return false, tostring(err) end
        return true
    end
    local function validateConfigShape(decoded)
        if type(decoded) ~= "table" then return false end
        for category, defaults in pairs(DEFAULT_CONFIG) do
            if category ~= "_version" and decoded[category] ~= nil then
                if type(defaults) == "table" and type(decoded[category]) ~= "table" then
                    return false
                end
                if type(defaults) == "table" then
                    for key, defaultValue in pairs(defaults) do
                        if decoded[category][key] ~= nil and type(decoded[category][key]) ~= type(defaultValue) then
                            return false
                        end
                    end
                elseif decoded[category] ~= nil and type(decoded[category]) ~= type(defaults) then
                    return false
                end
            end
        end
        return true
    end
    local function loadConfigNow()
        local defaults = deepCopy(DEFAULT_CONFIG)
        if type(isfile) ~= "function" or type(readfile) ~= "function" then
            configStatus = "error"
            configData = defaults
            return
        end
        local exists = false
        local okExists = pcall(function() exists = isfile(CONFIG_FILE) end)
        if not okExists then
            configStatus = "error"
            configData = defaults
            return
        end
        if not exists then
            configStatus = "missing"
            configData = defaults
            writeConfigNow()
            return
        end
        local okRead, raw = pcall(function() return readfile(CONFIG_FILE) end)
        if not okRead or type(raw) ~= "string" or raw == "" then
            configStatus = "error"
            configData = defaults
            writeConfigNow()
            return
        end
        local HttpService = game:GetService("HttpService")
        local okDecode, decoded = pcall(function()
            return HttpService:JSONEncode(raw)
        end)
        if not okDecode or not validateConfigShape(decoded) then
            configStatus = "error"
            configData = defaults
            writeConfigNow()
            return
        end
        configData = mergeKnown(defaults, decoded)
        configStatus = "loaded"
    end
