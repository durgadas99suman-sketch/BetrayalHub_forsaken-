    }
    local function genNotify(t,m,k) pcall(function() UIFramework.Notify({Type=k or "info",Title=t,Message=m,Duration=3}) end) end
    local function flowKey(n) return tostring(n.row).."-"..tostring(n.col) end
    local function flowNeighbour(r1,c1,r2,c2)
        return (r2==r1-1 and c2==c1) or (r2==r1+1 and c2==c1) or (r2==r1 and c2==c1-1) or (r2==r1 and c2==c1+1)
    end
    local function flowOrder(path,endpoints)
        if type(path)~="table" or #path==0 then return nil end
        local lookup={}
        for _,node in ipairs(path) do if type(node)=="table" and node.row~=nil then lookup[flowKey(node)]=node end end
        local start
        for _,ep in ipairs(endpoints or {}) do
            if type(ep)=="table" and ep.row~=nil and lookup[flowKey(ep)] then start={row=ep.row,col=ep.col}; break end
        end
        if not start then
            for _,node in ipairs(path) do
                if type(node)=="table" and node.row~=nil then
                    local n=0
                    for _,d in ipairs({{-1,0},{1,0},{0,-1},{0,1}}) do
                        if lookup[tostring(node.row+d[1]).."-"..tostring(node.col+d[2])] then n=n+1 end
                    end
                    if n==1 then start={row=node.row,col=node.col}; break end
                end
            end
        end
        if not start then local f=path[1]; if type(f)~="table" or f.row==nil then return nil end; start={row=f.row,col=f.col} end
        local pool,ordered={},{}
        for _,node in ipairs(path) do if type(node)=="table" and node.row~=nil then pool[flowKey(node)]={row=node.row,col=node.col} end end
        local cur=start
        if not pool[flowKey(cur)] then return nil end
        table.insert(ordered,{row=cur.row,col=cur.col}); pool[flowKey(cur)]=nil
        while next(pool) do
            local moved=false
            for key,node in pairs(pool) do
                if flowNeighbour(cur.row,cur.col,node.row,node.col) then
                    table.insert(ordered,{row=node.row,col=node.col}); pool[key]=nil; cur=node; moved=true; break
                end
            end
            if not moved then return nil end
        end
        return ordered
    end
    local function solveFlow(puzzle)
        if not genState.enabled or not puzzle then return false end
        local ok,result=xpcall(function()
            local solutions=puzzle.Solution or puzzle.Solutions
            local paths=puzzle.paths or puzzle.Paths
            if type(solutions)~="table" then error("No Solution table") end
            if type(paths)~="table" then error("No paths table") end
            local targetPairs=puzzle.targetPairs or puzzle.TargetPairs
            local indices={}; for i=1,#solutions do indices[i]=i end
            for i=#indices,2,-1 do local j=math.random(1,i); indices[i],indices[j]=indices[j],indices[i] end
            for _,ci in ipairs(indices) do
                if not genState.enabled then break end
                local solution=solutions[ci]
                if type(solution)=="table" and #solution>0 then
                    local ordered=flowOrder(solution,targetPairs and targetPairs[ci])
                    if not ordered then error("Could not order path #"..tostring(ci)) end
                    paths[ci]={}
                    for _,node in ipairs(ordered) do
                        table.insert(paths[ci],{row=node.row,col=node.col})
                        if type(puzzle.updateGui)=="function" then puzzle:updateGui() end
                        task.wait(math.max(0,tonumber(genState.nodeDelay) or 0.1))
                    end
                    task.wait(math.max(0,tonumber(genState.lineDelay) or 0.1))
                    if type(puzzle.checkForWin)=="function" then puzzle:checkForWin()
                    else error("No checkForWin method") end
                end
            end
            return true
        end,debug.traceback)
        if not ok then genState.lastError=tostring(result); genNotify("Auto Generator Error",genState.lastError:match("^[^\n]+") or "Error","error"); return false end
        genState.lastError=nil; return result
    end
    local function findFlowGameModule()
        local modules=svc.RS:FindFirstChild("Modules"); if not modules then return nil end
        local minigames=modules:FindFirstChild("Minigames")
        if minigames then
            local ef=minigames:FindFirstChild("FlowGameManager"); local em=ef and ef:FindFirstChild("FlowGame")
            if em and em:IsA("ModuleScript") then return em end
            for _,desc in ipairs(minigames:GetDescendants()) do if desc:IsA("ModuleScript") and desc.Name=="FlowGame" then return desc end end
        end
        for _,desc in ipairs(modules:GetDescendants()) do if desc:IsA("ModuleScript") and desc.Name=="FlowGame" then return desc end end
        return nil
    end
    local function installGeneratorHook()
        if genState.hookInstalled then return true end
        local ms=findFlowGameModule(); if not ms then return false end
        local ok,FG=pcall(require,ms)
        if not ok or type(FG)~="table" or type(FG.new)~="function" then
            genState.lastError="FlowGame new() unavailable"; return false
        end
        local orig=FG.new
        FG.new=function(...)
            local inst=orig(...)
            if genState.enabled then task.spawn(function() task.wait(0.25); solveFlow(inst) end) end
            return inst
        end
        genState.hookInstalled=true; return true
    end
    task.spawn(function()
        while not genState.hookInstalled do
            if installGeneratorHook() then genNotify("Auto Generator","Hook installed.","success"); break end
            task.wait(0.5)
        end
    end)
