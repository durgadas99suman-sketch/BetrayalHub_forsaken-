-- Auto Play Loop task.spawn(function() while true do task.wait(0.1) pcall(function() if not helper or not helper.autoPlay then return end local char = lp.Character local hrp = char and char:FindFirstChild("HumanoidRootPart") local hum = char and char:FindFirstChildOfClass("Humanoid") if not hrp or not hum or hum.Health <= 0 then return end

local kf = getTeamFolder("Killers") local khrp, kd = nil, math.huge if kf then for _, killer in ipairs(kf:GetChildren()) do if killer:IsA("Model") then local r = killer:FindFirstChild("HumanoidRootPart") local h = killer:FindFirstChildOfClass("Humanoid") if r and h and h.Health > 0 then local d = (r.Position - hrp.Position).Magnitude if d < kd then kd = d; khrp = r end end end end end

local apprVel, isTargetingMe = updateKillerApproach(hrp, khrp) local kStam = updateKillerStam(helper.killerStamEst, khrp) local myStam = readStamina()

if kd < 30 and isTargetingMe then if helper.autoGhostburger and hum.Health < 40 then fireGhostburger() end if helper.autoBloxy and (kd < 15 or kStam > 50) then fireBloxyCola() end if helper.autoSlate and kd < 8 then fireSlateskin() end end

if khrp and kd < 35 then helper.playState = "LOOPING" managedSprint(myStam, kd)

