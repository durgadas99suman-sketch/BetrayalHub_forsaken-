    local function executeBackstab(killer)
        tt.lastStab=os.clock()
        local kHRP=killer:FindFirstChild("HumanoidRootPart");local char=lp.Character
        local myHRP=char and char:FindFirstChild("HumanoidRootPart");local hum=char and char:FindFirstChildOfClass("Humanoid")
        if not kHRP or not myHRP or not hum then return end
