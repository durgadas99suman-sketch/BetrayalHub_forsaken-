    -- Facing visuals
    local facingVisuals = {}
    local function updateFacingVisual(killer, visual)
        if not (killer and visual and visual.Parent) then return end
        local hrp = killer:FindFirstChild("HumanoidRootPart"); if not hrp then return end
        local dot = math.clamp(customFacingDot or 0.3, -1, 1)
        local frac = math.acos(dot) / math.pi
        local radius = math.max(1, detectionRange * (0.20 + 0.80*frac))
        visual.Radius = radius; visual.Height = 0.12
        visual.CFrame = CFrame.new(0,-(hrp.Size.Y/2+0.05),-detectionRange*(0.35+0.15*frac))*CFrame.Angles(math.rad(90),0,0)
        local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local inRange = myRoot and (hrp.Position-myRoot.Position).Magnitude <= detectionRange
        visual.Color3 = inRange and Color3.fromRGB(255,0,0) or Color3.fromRGB(255,255,0)
        visual.Transparency = inRange and 0.40 or 0.85
    end
