-- Role detection: dark → background, bright+saturated → accent,
-- bright+neutral → text, everything else → mid (trim/borders).
local function colorRole(c)
    local r, g, b = c.R, c.G, c.B
    local max = math.max(r, g, b)
    local min = math.min(r, g, b)
    local v = max
    local d = max - min
    local s = (max <= 0) and 0 or (d / max)
    if v <= 0.28 then return "background" end
    if s >= 0.28 and v >= 0.45 then return "accent" end
    if v >= 0.62 and s <= 0.25 then return "text" end
    return "mid"
end

local function mapColor(c)
    local role = colorRole(c)
    if role == "accent" then
        return THEME.accent
    elseif role == "background" then
        return c:Lerp(THEME.bgTint, THEME.bgStrength)
    elseif role == "mid" then
        return c:Lerp(THEME.accent2, 0.35)   -- subtle purple sci-fi trim
    elseif role == "text" then
        return c:Lerp(THEME.accent, 0.08)    -- faint cyan cast on text
    end
    return c
end

-- Snapshot each instance's ORIGINAL colors the first time we see
-- it, so repeated theme applications never drift or compound.
local function snapshotInstance(obj)
    local snap = themeEngine.snapshot[obj]
    if snap then return snap end
    snap = {}
    pcall(function()
        if obj:IsA("GuiObject") then
            snap.bg = obj.BackgroundColor3
            snap.trans = obj.BackgroundTransparency
        end
        if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then
            snap.text = obj.TextColor3
        end
        if obj:IsA("UIStroke") then
            snap.stroke = obj.Color
        end
        if obj:IsA("UIGradient") then
            snap.gradient = obj.Color
        end
    end)
    themeEngine.snapshot[obj] = snap
    return snap
end

local function applyThemePass()
    local root = themeEngine.gui
    if not root then return end
    for _, obj in ipairs(root:GetDescendants()) do
        pcall(function()
            local snap = snapshotInstance(obj)
            if snap.bg then
                obj.BackgroundColor3 = mapColor(snap.bg)
                if snap.trans and snap.trans < 0.40 and colorRole(snap.bg) == "background" then
                    obj.BackgroundTransparency = math.clamp(snap.trans + THEME.transparency, snap.trans, 0.42)
                end
            end
            if snap.text then
                obj.TextColor3 = mapColor(snap.text)
            end
            if snap.stroke then
                obj.Color = mapColor(snap.stroke)
            end
            if snap.gradient then
                local keypoints = {}
                for _, kp in ipairs(snap.gradient.Keypoints) do
                    table.insert(keypoints, ColorSequenceKeypoint.new(kp.Time, mapColor(kp.Value)))
                end
                obj.Color = ColorSequence.new(keypoints)
            end
        end)
    end
end

-- Throttled apply (max ~5/sec) so slider drags stay smooth and
-- dynamically-created elements (notifications, dropdown lists)
-- also get themed via the DescendantAdded hook.
local function scheduleApply()
    if themeEngine.applyScheduled then return end
    themeEngine.applyScheduled = true
    task.defer(function()
        local wait = 0.2 - (os.clock() - themeEngine.lastApply)
        if wait > 0 then task.wait(wait) end
        applyThemePass()
        themeEngine.lastApply = os.clock()
        themeEngine.applyScheduled = false
    end)
end

