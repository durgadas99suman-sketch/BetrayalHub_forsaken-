local function fireBloxyCola() fireNoobAbility({"\3\4\0\0\0Cola","\3\5\0\0\0BloxyCola"},{"cola","bloxy","speed"}) end
local function fireSlateskin() fireNoobAbility({"\3\6\0\0\0Slate","\3\7\0\0\0Slateskin"},{"slate","potion","tank","stone"}) end

