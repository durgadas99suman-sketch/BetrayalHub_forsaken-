--------------------------------------------------------------------------------
-- STATE MACHINE CONTROLLER
--------------------------------------------------------------------------------
local loadingThread = nil

local function setState(newState, message)
    currentState = newState
    statusLabel.Text = message or ""

    if newState == State.IDLE then
        isRequesting = false
        checkButton.Text = "Check Key"
        checkButton.BackgroundColor3 = COLORS.Accent
        statusLabel.TextColor3 = COLORS.TextSecondary
        if loadingThread then
            task.cancel(loadingThread)
            loadingThread = nil
        end

    elseif newState == State.CHECKING then
        isRequesting = true
        checkButton.BackgroundColor3 = COLORS.CardBorder
        statusLabel.TextColor3 = COLORS.Warning
        
        if loadingThread then task.cancel(loadingThread) end
        loadingThread = task.spawn(function()
            local frames = {
                "📡 Connecting, please wait.",
                "📡 Connecting, please wait..",
                "📡 Connecting, please wait..."
            }
            local idx = 1
            while currentState == State.CHECKING do
                checkButton.Text = "Connecting..."
                statusLabel.Text = (message and message ~= "" and message) or frames[idx]
                idx = (idx % #frames) + 1
                task.wait(0.35)
            end
        end)

    elseif newState == State.SUCCESS then
        isRequesting = false
        if loadingThread then
            task.cancel(loadingThread)
            loadingThread = nil
        end
        checkButton.Text = "Verified!"
        checkButton.BackgroundColor3 = COLORS.Success
        statusLabel.TextColor3 = COLORS.Success

    elseif newState == State.ERROR then
        isRequesting = false
        if loadingThread then
            task.cancel(loadingThread)
            loadingThread = nil
        end
        checkButton.Text = "Check Key"
        checkButton.BackgroundColor3 = COLORS.Accent
        statusLabel.TextColor3 = COLORS.Error
    end
end

