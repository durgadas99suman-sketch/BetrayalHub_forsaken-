        return (ok and t) or "Neon Black"
    end
    function UIFramework.SetTheme(theme) return WindUI:SetTheme(theme) end
    function UIFramework.CreateSection(data)
        if hiddenParent(data and data.Parent) then return nil end
        local parent = data and data.Parent
        if not parent or type(parent.Section) ~= "function" then return nil end
        return parent:Section({ Title=data.Text or data.Title or "Section", Box=false, Opened=true })
    end
    local function addSection(tab, title)
        return UIFramework.CreateSection({ Parent=tab, Text=title })
    end
    function UIFramework.CreateButtonGroup(data)
        if hiddenParent(data and data.Parent) then return {__hidden=true} end
        local parent = data and data.Parent
        if parent and type(parent.Group) == "function" then return parent:Group({}) end
        return parent
    end
    local function parentElement(parent, method, config)
        if hiddenParent(parent) then return {__hidden=true} end
        if not parent or type(parent[method]) ~= "function" then
            error("Invalid WindUI parent for "..tostring(method))
        end
        return parent[method](parent, config)
    end
    UIFramework.Toggle = { new = function(config)
        if hiddenParent(config.Parent) then return {__hidden=true} end
        return parentElement(config.Parent, "Toggle", { Title=config.Text or config.Title or "Toggle", Desc=config.Desc, Icon=config.Icon, Value=config.Value==true, Locked=config.Locked==true, Callback=config.OnChange })
    end }
    UIFramework.Slider = { new = function(config)
        if hiddenParent(config.Parent) then return {__hidden=true} end
        return parentElement(config.Parent, "Slider", { Title=config.Text or config.Title or "Slider", Desc=config.Desc, Icon=config.Icon, Step=config.Step or 1, Value={ Min=config.Min or 0, Max=config.Max or 100, Default=tonumber(config.Value) or config.Min or 0 }, Callback=config.OnChange })
    end }
    UIFramework.Dropdown = { new = function(config)
        if hiddenParent(config.Parent) then return {__hidden=true} end
        local values = {}
        for _, option in ipairs(config.Options or {}) do
            table.insert(values, type(option)=="table" and (option.Value or option.Text or option.Title) or option)
