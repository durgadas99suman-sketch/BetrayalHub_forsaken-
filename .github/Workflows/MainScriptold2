--// Script Unavailable Screen
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "UnavailableScreen"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = playerGui

local bg = Instance.new("Frame")
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
bg.BackgroundTransparency = 0.08
bg.Parent = gui

local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(15, 10, 30)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(5, 15, 25)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 5, 20))
})
gradient.Rotation = 45
gradient.Parent = bg

local box = Instance.new("Frame")
box.AnchorPoint = Vector2.new(0.5, 0.5)
box.Position = UDim2.fromScale(0.5, 0.52)
box.Size = UDim2.fromScale(0.7, 0.28)
box.BackgroundColor3 = Color3.fromRGB(18, 18, 25)
box.BackgroundTransparency = 0.08
box.Parent = bg

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 18)
corner.Parent = box

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(130, 90, 255)
stroke.Thickness = 2
stroke.Transparency = 0.2
stroke.Parent = box

local title = Instance.new("TextLabel")
title.BackgroundTransparency = 1
title.Size = UDim2.fromScale(0.9, 0.3)
title.Position = UDim2.fromScale(0.05, 0.1)
title.Font = Enum.Font.GothamBold
title.Text = "⚠ SCRIPT UNAVAILABLE"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.Parent = box

local message = Instance.new("TextLabel")
message.BackgroundTransparency = 1
message.Size = UDim2.fromScale(0.9, 0.25)
message.Position = UDim2.fromScale(0.05, 0.42)
message.Font = Enum.Font.Gotham
message.Text = "The script is currently unavailable."
message.TextColor3 = Color3.fromRGB(190, 190, 200)
message.TextScaled = true
message.Parent = box

local loading = Instance.new("TextLabel")
loading.BackgroundTransparency = 1
loading.Size = UDim2.fromScale(0.9, 0.2)
loading.Position = UDim2.fromScale(0.05, 0.68)
loading.Font = Enum.Font.GothamMedium
loading.Text = "Please wait •"
loading.TextColor3 = Color3.fromRGB(170, 130, 255)
loading.TextScaled = true
loading.Parent = box

--// Animated loading dots
task.spawn(function()
    local dots = 1

    while gui.Parent do
        loading.Text = "Please wait " .. string.rep("•", dots)

        dots += 1
        if dots > 3 then
            dots = 1
        end

        task.wait(0.45)
    end
end)

--// Floating/pulsing effect
task.spawn(function()
    while gui.Parent do
        TweenService:Create(
            box,
            TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {Position = UDim2.fromScale(0.5, 0.50)}
        ):Play()

        task.wait(1.4)

        TweenService:Create(
            box,
            TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {Position = UDim2.fromScale(0.5, 0.52)}
        ):Play()

        task.wait(1.4)
    end
end)
